{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Script Library Legacy",
  "version": "1.0.0-legacy.1",
  "identifier": "gg.nulls.library.desktop.legacy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Script Library",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "script-library"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
      "shortDescription": "Каталог скриптов Null's Brawl — Legacy",
    "longDescription": "Каталог скриптов Null's Brawl: поиск, авторы, код, избранное и запуск боя прямо с компьютера.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./WebView2Runtime"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "lua",
          "luau"
        ],
        "name": "Lua script",
        "description": "Скрипт Lua для Null's Brawl",
        "role": "Editor",
        "mimeType": "text/x-lua"
      }
    ]
  }
}
